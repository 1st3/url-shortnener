{
  "name": "brzl-shortener",
  "version": "1.0.0",
  "description": "High-performance, resource-efficient URL shortener for brzl.ca",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && (mkdir -p dist/db && cp -r src/db/migrations dist/db/ 2>/dev/null || true)",
    "start": "node --max-old-space-size=64 dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --test dist/**/*.test.js",
    "seed": "tsx scripts/seed-redirects.ts"
  },
  "keywords": [
    "url-shortener",
    "fastify",
    "sqlite",
    "cloudflare"
  ],
  "author": "Daniel <iam@w-b.dev>",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nanoid": "^5.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
